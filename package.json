{
  "name": "aura-browser",
  "version": "2.1.0",
  "description": "An immersive, distraction-free, completely fullscreen desktop browser with multi-tab vertical sidebar and Chrome extension support.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/elson222/aura-browser.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "electron test_suite.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "browser",
    "fullscreen",
    "zen",
    "minimal",
    "privacy",
    "tabs",
    "extensions",
    "ublock-origin",
    "open-source"
  ],
  "author": {
    "name": "Cornel Media (elson222)",
    "email": "info@cornel.media",
    "url": "https://github.com/elson222"
  },
  "license": "MIT",
  "dependencies": {
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aura.browser",
    "productName": "Aura Browser",
    "icon": "assets/icon.ico",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
